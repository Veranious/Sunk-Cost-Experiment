function w = GenerateToneCloud(sf, f0, f1, dur, nBins, kappa, fLow, fHigh)

pipDur      = 0.030;   % s, pip length
pipInterval = 0.010;   % s, onset-to-onset (3x overlap)
rampDur     = 0.005;   % s, raised-cosine ramp each end
targetRMS   = 0.1;

n     = round(dur * sf);
w     = zeros(1, n);
freqs = logspace(log10(fLow), log10(fHigh), nBins);

pipN  = round(pipDur * sf);
rampN = round(rampDur * sf);
env   = ones(1, pipN);
ramp  = (1 - cos(pi * (1:rampN)/rampN)) / 2;
env(1:rampN)         = ramp;
env(end-rampN+1:end) = fliplr(ramp);

% pre-render one pip per bin
t    = (0:pipN-1)/sf;
pips = sin(2*pi*freqs(:)*t) .* env;        % nBins x pipN

% bin centres in normalised log-frequency units 
u = ((1:nBins) - 0.5) / nBins;

% where the cloud centre starts and ends
logLow = log(fLow);  logSpan = log(fHigh) - logLow;
c0 = (log(f0) - logLow) / logSpan;
c1 = (log(f1) - logLow) / logSpan;

nPips = floor((dur - pipDur) / pipInterval) + 1;
for i = 1:nPips
    frac = (i-1) / max(nPips-1, 1);
    mu   = min(max(c0 + (c1 - c0)*frac, 1e-3), 1-1e-3);   % centre slides c0 -> c1

    a = mu*kappa;  b = (1-mu)*kappa;      % Beta with mean mu, concentration kappa
    wgt = u.^(a-1) .* (1-u).^(b-1);
    wgt = wgt / sum(wgt);
    idx = find(rand <= cumsum(wgt), 1);   % draw this pip's bin

    onset = round((i-1) * pipInterval * sf) + 1;
    last  = onset + pipN - 1;
    if last <= n
        w(onset:last) = w(onset:last) + pips(idx,:);
    end
end

% RMS-normalise so loudness doesn't depend on how pips happened to align (Maybe keep this ?)
r = sqrt(mean(w.^2));
if r > 0, w = w * (targetRMS / r); end
pk = max(abs(w));
if pk > 0.95, w = w * (0.95 / pk); end   % rare, avoids clipping
end
